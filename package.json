{
  "name": "formatcast",
  "version": "0.1.0",
  "description": "Resolve and run format conversions: detect a format (explicit spec, extension, MIME type, magic bytes), route through codecs, load each codec only when needed.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Thor Whalen",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thorwhalen/formatcast.git"
  },
  "homepage": "https://github.com/thorwhalen/formatcast#readme",
  "bugs": "https://github.com/thorwhalen/formatcast/issues",
  "keywords": [
    "format",
    "codec",
    "detection",
    "sniffing",
    "magic-bytes",
    "mime",
    "import",
    "export",
    "conversion",
    "registry",
    "yaml",
    "toml",
    "csv"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "prepublishOnly": "npm run build"
  },
  "wads": {
    "ci": {
      "nodeVersions": [
        "22"
      ],
      "lintCommand": "npm run typecheck",
      "testCommand": "npm test",
      "buildCommand": "npm run build",
      "publish": {
        "enabled": true
      }
    }
  },
  "dependencies": {
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
